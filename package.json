{
  "name": "@omerdlw/base-framework",
  "version": "3.5.0",
  "description": "Microkernel engine and first-party declarative UI modules for app-like Next.js products.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./result": {
      "types": "./dist/result/index.d.ts",
      "import": "./dist/result/index.js",
      "default": "./dist/result/index.js"
    },
    "./events": {
      "types": "./dist/events/index.d.ts",
      "import": "./dist/events/index.js",
      "default": "./dist/events/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js",
      "default": "./dist/utils/index.js"
    },
    "./recipes": {
      "types": "./dist/recipes/index.d.ts",
      "import": "./dist/recipes/index.js",
      "default": "./dist/recipes/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js",
      "default": "./dist/hooks/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js",
      "default": "./dist/theme/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js",
      "default": "./dist/ui/index.js"
    },
    "./kernel": {
      "types": "./dist/kernel/index.d.ts",
      "import": "./dist/kernel/index.js",
      "default": "./dist/kernel/index.js"
    },
    "./error": {
      "types": "./dist/error/index.d.ts",
      "import": "./dist/error/index.js",
      "default": "./dist/error/index.js"
    },
    "./provider": {
      "types": "./dist/provider/index.d.ts",
      "import": "./dist/provider/index.js",
      "default": "./dist/provider/index.js"
    },
    "./modules": {
      "types": "./dist/modules/index.d.ts",
      "import": "./dist/modules/index.js",
      "default": "./dist/modules/index.js"
    },
    "./ambient": {
      "types": "./dist/ambient/index.d.ts",
      "import": "./dist/ambient/index.js",
      "default": "./dist/ambient/index.js"
    },
    "./ambient/server": {
      "types": "./dist/ambient/server/index.d.ts",
      "import": "./dist/ambient/server/index.js",
      "default": "./dist/ambient/server/index.js"
    },
    "./ambient/worker": {
      "types": "./dist/ambient/worker/index.d.ts",
      "import": "./dist/ambient/worker/index.js",
      "default": "./dist/ambient/worker/index.js"
    },
    "./background": {
      "types": "./dist/background/index.d.ts",
      "import": "./dist/background/index.js",
      "default": "./dist/background/index.js"
    },
    "./context-menu": {
      "types": "./dist/context-menu/index.d.ts",
      "import": "./dist/context-menu/index.js",
      "default": "./dist/context-menu/index.js"
    },
    "./controls": {
      "types": "./dist/controls/index.d.ts",
      "import": "./dist/controls/index.js",
      "default": "./dist/controls/index.js"
    },
    "./dock": {
      "types": "./dist/dock/index.d.ts",
      "import": "./dist/dock/index.js",
      "default": "./dist/dock/index.js"
    },
    "./loading": {
      "types": "./dist/loading/index.d.ts",
      "import": "./dist/loading/index.js",
      "default": "./dist/loading/index.js"
    },
    "./media": {
      "types": "./dist/media/index.d.ts",
      "import": "./dist/media/index.js",
      "default": "./dist/media/index.js"
    },
    "./modal": {
      "types": "./dist/modal/index.d.ts",
      "import": "./dist/modal/index.js",
      "default": "./dist/modal/index.js"
    },
    "./navigation": {
      "types": "./dist/navigation/index.d.ts",
      "import": "./dist/navigation/index.js",
      "default": "./dist/navigation/index.js"
    },
    "./notification": {
      "types": "./dist/notification/index.d.ts",
      "import": "./dist/notification/index.js",
      "default": "./dist/notification/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "!docs/superpowers",
    "templates",
    "README.md",
    "MIGRATION.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && ./node_modules/.bin/tsup && ./node_modules/.bin/tsc --emitDeclarationOnly --outDir dist && node scripts/rewrite-dts-aliases.mjs",
    "prepublishOnly": "npm run build && npm run test:dist",
    "dev": "./node_modules/.bin/tsup --watch",
    "type-check": "./node_modules/.bin/tsc --noEmit && ./node_modules/.bin/tsc -p templates && ./node_modules/.bin/tsc -p tests/types",
    "lint": "./node_modules/.bin/eslint .",
    "lint:fix": "./node_modules/.bin/eslint . --fix",
    "format": "./node_modules/.bin/prettier --write .",
    "format:check": "./node_modules/.bin/prettier --check .",
    "sync-exports": "node scripts/sync-exports.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "test": "node --import ./tests/support/register.mjs --test 'tests/**/*.test.ts'",
    "test:dist": "BASE_FRAMEWORK_TARGET=dist node --import ./tests/support/register.mjs --test 'tests/bundle/*.smoke.ts'",
    "verify": "npm run format:check && npm run lint && npm run type-check && npm run check:architecture && npm test && npm run build && npm run test:dist",
    "pack": "npm run build && npm pack",
    "clean": "rm -rf dist *.tgz"
  },
  "peerDependencies": {
    "motion": "^12.0.0 || ^13.0.0",
    "next": ">=15.0.0",
    "react": ">=19.2.0",
    "react-dom": ">=19.2.0",
    "sharp": "^0.35.0"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  },
  "dependencies": {
    "@iconify-icon/react": "3.0.3",
    "@radix-ui/react-tooltip": "1.2.16",
    "clsx": "2.1.1",
    "loading-dev": "^0.3.5",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-typescript": "7.28.5",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.13.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.14.0",
    "happy-dom": "^20.14.5",
    "motion": "^13.5.0",
    "prettier": "^3.10.1",
    "tsup": "^8.5.1",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.72.2"
  },
  "license": "MIT"
}

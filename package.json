{
  "name": "@omerdlw/base-framework",
  "version": "1.0.1",
  "description": "Microkernel engine and first-party declarative UI modules for app-like Next.js products.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./kernel": {
      "types": "./dist/kernel/index.d.ts",
      "import": "./dist/kernel/index.js",
      "default": "./dist/kernel/index.js"
    },
    "./result": {
      "types": "./dist/result.d.ts",
      "import": "./dist/result.js",
      "default": "./dist/result.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "import": "./dist/events.js",
      "default": "./dist/events.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.js",
      "default": "./dist/theme.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.js",
      "default": "./dist/tokens/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js",
      "default": "./dist/utils/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js",
      "default": "./dist/hooks/index.js"
    },
    "./error": {
      "types": "./dist/error/index.d.ts",
      "import": "./dist/error/index.js",
      "default": "./dist/error/index.js"
    },
    "./provider": {
      "types": "./dist/provider.d.ts",
      "import": "./dist/provider.js",
      "default": "./dist/provider.js"
    },
    "./atoms": {
      "types": "./dist/atoms/index.d.ts",
      "import": "./dist/atoms/index.js",
      "default": "./dist/atoms/index.js"
    },
    "./modules": {
      "types": "./dist/modules/index.d.ts",
      "import": "./dist/modules/index.js",
      "default": "./dist/modules/index.js"
    },
    "./modules/*": {
      "types": "./dist/modules/*/index.d.ts",
      "import": "./dist/modules/*/index.js",
      "default": "./dist/modules/*/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --outDir dist",
    "prepublishOnly": "npm run build",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "check:architecture": "node scripts/check-architecture.mjs",
    "test": "node --import ./tests/support/register.mjs --test 'tests/**/*.test.ts'",
    "pack": "npm run build && npm pack",
    "clean": "rm -rf dist *.tgz"
  },
  "peerDependencies": {
    "motion": "^12.0.0 || ^13.0.0",
    "next": ">=15.0.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "dependencies": {
    "@iconify-icon/react": "3.0.3",
    "@radix-ui/react-tooltip": "1.2.16",
    "clsx": "2.1.1",
    "loading-dev": "^0.3.5",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "happy-dom": "^20.14.5",
    "motion": "^13.5.0",
    "tsup": "^8.5.1",
    "typescript": "^5.8.2"
  },
  "license": "MIT"
}
